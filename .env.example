# Required
TELEGRAM_API_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Needed by `devy webhook set` (or pass the URL as an argument)
# TELEGRAM_WEBHOOK_URL=https://devy.example.com/webhook/telegram

# Telegram topic (thread) ids; a topic left unset is sent to the chat itself
# TELEGRAM_TOPIC_GENERAL=
# TELEGRAM_TOPIC_GITHUB=
# TELEGRAM_TOPIC_LOGS=
# TELEGRAM_TOPIC_NOTIFICATIONS=

# Bot settings (defaults shown)
# DEVY_ADDR=0.0.0.0:8000
# DEVY_MAX_BODY_BYTES=26214400
# DEVY_MAX_TEXT_CHARS=4096
# DEVY_BODY_EXCERPT_CHARS=1500
# RUST_LOG=info
